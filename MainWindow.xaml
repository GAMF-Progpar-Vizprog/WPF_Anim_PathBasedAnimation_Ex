<Window x:Class="WPF_Anim_PathBasedAnimation_Ex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Anim_PathBasedAnimation_Ex"
        mc:Ignorable="d"
        Title="Path-based animation example" Height="450" Width="494">
	<DockPanel>
		<ToolBar DockPanel.Dock="Top" Height="30" Name="toToolBar">
			<Button Name="btStart" Click="btStart_Click" Content="Start"/>
		</ToolBar>
		<Canvas Name="cvPage" DockPanel.Dock="Top">
			<Rectangle Name="rcSqare" Width="10" Fill="IndianRed" Height="10" Canvas.Left="100" Canvas.Top="100"/>
		</Canvas>
	</DockPanel>

</Window>